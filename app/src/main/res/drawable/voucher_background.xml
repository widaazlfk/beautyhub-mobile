<?xml version="1.0" encoding="utf-8"?>
<!-- Menghasilkan satu segi empat tepat dengan latar belakang putih,
     garisan (stroke) kelabu nipis, dan bucu yang sedikit bulat. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Warna latar belakang kad baucar -->
    <solid android:color="@android:color/white" />

    <!-- Bucu yang dibulatkan -->
    <corners android:radius="8dp" />

    <!-- Garisan kelabu di sekeliling kad -->
    <stroke
        android:width="1dp"
        android:color="#E0E0E0" />

</shape>
