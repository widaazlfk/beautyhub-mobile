<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    app:cardElevation="0dp"
    app:cardCornerRadius="0dp"
    android:layout_marginBottom="1dp">

    <!-- Kita guna CardElevation 0 supaya nampak flat macam Shopee -->

    <LinearLayout
        android:id="@+id/notification_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="15dp"
        android:background="?android:attr/selectableItemBackground">

        <!-- Gambar Produk dengan Stroke Maroon Nipis -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="55dp"
            android:layout_height="55dp"
            app:cardCornerRadius="4dp"
            app:cardElevation="0dp"
            app:strokeWidth="1dp"
            app:strokeColor="#F0F0F0">

            <ImageView
                android:id="@+id/notification_product_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                android:src="@drawable/product_placeholder" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/notification_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Order Status Updated"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#222222"/>

            <TextView
                android:id="@+id/notification_product_name"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Product Name"
                android:maxLines="1"
                android:ellipsize="end"
                android:textColor="#800000"
                android:textSize="13sp"/> <!-- Warna Maroon -->

            <TextView
                android:id="@+id/notification_seller_info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Seller Name"
                android:textColor="#888888"
                android:textSize="12sp"/>

            <TextView
                android:id="@+id/notification_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="2 mins ago"
                android:textSize="11sp"
                android:textColor="#999999"/>
        </LinearLayout>

        <!-- Titik Indikator Maroon (Belum Dibaca) -->
        <View
            android:id="@+id/unread_indicator"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_gravity="center_vertical"
            android:layout_marginStart="8dp"
            android:background="@drawable/shape_circle_maroon"
            android:visibility="visible" />

    </LinearLayout>

</androidx.cardview.widget.CardView>