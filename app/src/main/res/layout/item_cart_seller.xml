<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="8dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Seller Header -->
        <LinearLayout
            android:id="@+id/seller_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp"
            android:clickable="true"
            android:focusable="true"
            android:background="?selectableItemBackground">

            <!-- Seller Profile Image -->
            <ImageView
                android:id="@+id/iv_seller_profile"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:scaleType="centerCrop"
                android:src="@drawable/ic_profile"
                android:layout_marginEnd="12dp" />

            <!-- Seller Name with Checkbox -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/tv_seller_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Seller Name"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:drawablePadding="4dp"
                    android:maxLines="1"
                    android:ellipsize="end" />

                <!-- Optional: Seller rating or info -->
                <TextView
                    android:id="@+id/tv_seller_info"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Official Store"
                    android:textSize="12sp"
                    android:textColor="@color/gray_dark"
                    android:visibility="gone" />

            </LinearLayout>

            <!-- Select All Checkbox -->
            <CheckBox
                android:id="@+id/checkbox_seller_select_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="Select All"
                android:textSize="14sp" />

        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/gray_light"
            android:layout_marginHorizontal="16dp" />

        <!-- Cart Items RecyclerView -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_cart_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingVertical="8dp"
            android:nestedScrollingEnabled="false" />

    </LinearLayout>

</androidx.cardview.widget.CardView>