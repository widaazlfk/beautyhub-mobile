<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Review Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- User Avatar -->
            <ImageView
                android:id="@+id/iv_user_avatar"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_user_avatar"
                android:background="@color/light_gray"
                android:scaleType="centerCrop"
                android:layout_marginEnd="12dp" />

            <!-- User Info and Rating -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_user_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sarah Johnson"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <RatingBar
                    android:id="@+id/rating_bar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:numStars="5"
                    android:stepSize="1"
                    android:rating="5"
                    android:isIndicator="true"
                    style="@style/Widget.AppCompat.RatingBar.Small"
                    android:layout_marginTop="2dp" />

            </LinearLayout>

            <!-- Review Date -->
            <TextView
                android:id="@+id/tv_review_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="2 weeks ago"
                android:textSize="12sp"
                android:textColor="@color/gray" />

        </LinearLayout>

        <!-- Review Title -->
        <TextView
            android:id="@+id/tv_review_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Amazing products! My skin feels fantastic"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginTop="12px" />

        <!-- Review Content -->
        <TextView
            android:id="@+id/tv_review_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="I've been using this serum for 2 weeks now and I can already see a difference in my skin texture. It feels more hydrated and looks brighter. The packaging is also very elegant."
            android:textSize="14sp"
            android:lineSpacingExtra="4dp"
            android:layout_marginTop="8dp" />

        <!-- Review Images -->
        <HorizontalScrollView
            android:id="@+id/hsv_review_images"
            android:layout_width="match_parent"
            android:layout_height="100dp"
            android:layout_marginTop="12dp"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/ll_review_images"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:orientation="horizontal">

                <!-- Dynamic reviews images will be added here -->

            </LinearLayout>
        </HorizontalScrollView>

        <!-- Helpful Section -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp">

            <TextView
                android:id="@+id/tv_helpful_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="15 people found this helpful"
                android:textSize="12sp"
                android:textColor="@color/gray" />

            <View
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_weight="1" />

            <Button
                android:id="@+id/btn_helpful"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Helpful"
                android:textSize="12sp"
                android:backgroundTint="@color/transparent"
                android:textColor="@color/primary_color"
                style="@style/Widget.Material3.Button.TextButton" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>