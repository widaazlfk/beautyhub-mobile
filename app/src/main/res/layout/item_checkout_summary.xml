<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    android:layout_marginTop="4dp"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="12dp">

        <!-- Seller Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/ic_store"
                app:tint="?attr/colorPrimary"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/tv_checkout_item_seller_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textSize="13sp"
                android:textStyle="bold"
                tools:text="Seller Name"/>

            <!-- Official Badge -->
            <TextView
                android:id="@+id/tv_checkout_official_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OFFICIAL"
                android:textSize="10sp"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:background="@drawable/badge_official"
                android:paddingHorizontal="6dp"
                android:paddingVertical="2dp"
                android:visibility="gone"
                tools:visibility="visible"/>

        </LinearLayout>

        <com.google.android.material.divider.MaterialDivider
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginBottom="12dp"/>


        <!-- Product Info Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <!-- Product Image -->
            <com.google.android.material.card.MaterialCardView
                android:layout_width="80dp"
                android:layout_height="80dp"
                app:cardCornerRadius="8dp"
                android:layout_marginEnd="12dp">
                <ImageView
                    android:id="@+id/iv_checkout_item_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    tools:src="@tools:sample/backgrounds/scenic" />
            </com.google.android.material.card.MaterialCardView>


            <!-- Product Details -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_checkout_item_name"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="15sp"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="?android:attr/textColorPrimary"
                    tools:text="Long Product Name That Wraps to a Second Line"/>

                <!-- Variant Info -->
                <TextView
                    android:id="@+id/tv_checkout_item_variant"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:visibility="gone"
                    tools:text="Variant: Large"
                    tools:visibility="visible"/>

                <!-- Quantity Display (x 1) -->
                <TextView
                    android:id="@+id/tv_checkout_item_quantity_total"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="13sp"
                    android:textColor="?android:attr/textColorSecondary"
                    android:layout_marginTop="4dp"
                    tools:text="x 1" />

                <!-- Stock Status -->
                <TextView
                    android:id="@+id/tv_checkout_stock_status"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginTop="4dp"
                    android:visibility="gone"
                    tools:textColor="@color/stock_warning"
                    tools:text="Low stock: 3 left"
                    tools:visibility="visible"/>
            </LinearLayout>

            <!-- Price -->
            <TextView
                android:id="@+id/tv_checkout_item_price"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textColor="?attr/colorPrimary"
                android:textStyle="bold"
                android:layout_gravity="bottom"
                tools:text="RM 89.90"/>
        </LinearLayout>

        <!-- Quantity Controls -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp">

            <Space
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@id/quantity_control_layout"/>

            <LinearLayout
                android:id="@+id/quantity_control_layout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:gravity="center_vertical"
                android:background="@drawable/quantity_control_background"
                android:orientation="horizontal">

                <!-- Decrease Button -->
                <ImageButton
                    android:id="@+id/btn_checkout_decrease"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_remove"
                    app:tint="?attr/colorPrimary"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <!-- Quantity Display -->
                <TextView
                    android:id="@+id/tv_checkout_quantity"
                    android:layout_width="40dp"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="1"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="?android:attr/textColorPrimary"
                    android:background="@drawable/quantity_display_background"/>

                <!-- Increase Button -->
                <ImageButton
                    android:id="@+id/btn_checkout_increase"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_add"
                    app:tint="?attr/colorPrimary"
                    android:background="?attr/selectableItemBackgroundBorderless"/>
            </LinearLayout>
        </RelativeLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
