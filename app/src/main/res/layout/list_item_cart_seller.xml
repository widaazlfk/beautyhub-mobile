<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="12dp"
    android:layout_marginHorizontal="8dp"
    app:cardElevation="2dp"
    app:cardCornerRadius="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Bahagian Header untuk Penjual -->
        <LinearLayout
            android:id="@+id/layout_seller_header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="12dp"
            android:paddingVertical="10dp">

            <!-- Checkbox untuk memilih semua item penjual ini -->
            <CheckBox
                android:id="@+id/checkbox_select_seller"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="10dp" />

            <!-- Gambar Profil Penjual -->
            <de.hdodenhof.circleimageview.CircleImageView
                android:id="@+id/iv_seller_profile_header"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/ic_profile" />

            <!-- Nama Penjual -->
            <TextView
                android:id="@+id/tv_seller_name_header"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:textStyle="bold"
                android:textSize="15sp"
                android:textColor="?android:attr/textColorPrimary"
                tools:text="Nama Penjual Rasmi" />

            <!-- Ikon 'arrow' untuk ke profil penjual -->
            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:layout_marginStart="4dp"
                android:src="@drawable/ic_chevron_right"
                app:tint="@color/gray_500" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?android:attr/listDivider" />

        <!-- RecyclerView untuk memaparkan senarai produk dari penjual ini -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rv_child_cart_items"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:nestedScrollingEnabled="false"
            tools:itemCount="2"
            tools:listitem="@layout/item_cart_item" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
